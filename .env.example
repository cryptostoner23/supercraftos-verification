# Copy to .env and chmod 600 .env. Keep all values server-side.
# Empty values are intentional: the control center needs no provider account.

# Recommended explicit OpenAI-compatible model route (HTTPS endpoint).
# Leave blank to use an automatically recognized provider below.
SUPERCRAFTOS_LLM_BASE_URL=
SUPERCRAFTOS_LLM_API_KEY=
SUPERCRAFTOS_MODEL=
SUPERCRAFTOS_LIGHT_MODEL=
OPENROUTER_API_KEY=

# Default legacy provider. Required for inference, not for offline checks.
NVIDIA_API_KEY=
# Alternative only after configuring/verifying the supported provider selection.
OPENCODE_GO_API_KEY=

# App embeds one durable worker by default. The systemd recipe disables it and
# runs main.py worker separately; do not run both workers against the same store.
# SUPERCRAFTOS_EMBEDDED_WORKER=1
# The host-side worker requires Docker and this pre-pulled command sandbox image.
# SUPERCRAFTOS_SANDBOX_IMAGE=python:3.12-slim

# Optional private HTTPS gateway (native systemd deployment).
# Set the exact external HTTPS origin, without a path, query, or fragment.
# Example: https://agents.example.com
SUPERCRAFTOS_PUBLIC_ORIGIN=
SUPERCRAFTOS_GATEWAY_PORT=8790
SUPERCRAFTOS_BACKEND_PORT=8787
# The reusable access key is generated in data/access.key, not in this file.
# Only expose the gateway behind TLS; keep backend port 8787 private.

# Optional Notion vault/setup; preserve data/vault.key with encrypted records.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
NOTION_STATE_DB_ID=
NOTION_VAULT_DB_ID=
NOTION_DEAD_ENDS_DB_ID=
NOTION_TOOLS_DB_ID=

# Optional Lark outbound WebSocket bot (comma-separated allowed user IDs).
LARK_APP_ID=
LARK_APP_SECRET=
LARK_ALLOWED_USER_IDS=

# Optional paid research, remote execution and cloud browser providers.
CONTEXT_DEV_API_KEY=
AIFLOWCHART_API_KEY=
E2B_API_KEY=
HYPERBROWSER_API_KEY=
STEEL_API_KEY=
# Optional rendered quest discovery; uses existing browser quota, cached 5 minutes.
BROWSERLESS_API_KEY=
APIFY_API_TOKEN=
FIRECRAWL_API_KEY=
COMPOSIO_API_KEY=

# Optional mailbox retrieval. Use an app password or OAuth token for IMAP.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_OAUTH_ACCESS_TOKEN=
# Web registration only; a login password is never an IMAP app password.
GMAIL_LOGIN_PASSWORD=

# Optional protocol adapters; supply real HTTPS endpoints and explicit hosts.
MAILBOX_PROVISION_URL=
MAILBOX_PROVISION_TOKEN=
MAILBOX_PROVISION_PAYLOAD={}
JMAP_SESSION_URL=
ACTIVATION_ALLOWED_HOSTS=

# Core deployments do not perform unattended dependency promotion or live checks.
# Compose explicitly forces both off; edit its environment section to opt in.
AUTO_UPGRADE=0
SYNC_CAPABILITIES=0

# Optional Compose image overrides. Use a unique tag/digest for each release.
# SUPERCRAFTOS_IMAGE=supercraftos:release-id
# PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:<approved-image-digest>
